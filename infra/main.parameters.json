{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "connectorNamespaceLocation": {
      "value": "${CONNECTOR_NAMESPACE_LOCATION=westcentralus}"
    },
    "openAiLocation": {
      "value": "${AZURE_OPENAI_LOCATION=eastus}"
    },
    "userPrincipalId": {
      "value": "${AZURE_PRINCIPAL_ID}"
    },
    "sharepointSiteUrl": {
      "value": "${SHAREPOINT_SITE_URL}"
    },
    "sharepointLibraryName": {
      "value": "${SHAREPOINT_LIBRARY_NAME}"
    },
    "sharepointFolderPath": {
      "value": "${SHAREPOINT_FOLDER_PATH=}"
    },
    "teamsTeamId": {
      "value": "${TEAMS_TEAM_ID}"
    },
    "teamsChannelId": {
      "value": "${TEAMS_CHANNEL_ID}"
    },
    "openAiDeploymentName": {
      "value": "${AZURE_OPENAI_DEPLOYMENT=gpt-4o}"
    }
  }
}
